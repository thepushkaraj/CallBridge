<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bridge arc: white → accent gradient along the path (phone → Mac).
         The mark spans ~80% of the visible mask so it never touches the
         launcher's edges and never clips the 66dp safe circle. -->
    <path
        android:pathData="M40,68 Q68,68 68,40"
        android:strokeLineCap="round"
        android:strokeWidth="5.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="68"
                android:endY="40"
                android:startX="40"
                android:startY="68"
                android:type="linear">
                <item
                    android:color="#F2F4F2"
                    android:offset="0" />
                <item
                    android:color="#4CC38A"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#F2F4F2"
        android:pathData="M40,68 m-8.5,0 a8.5,8.5 0 1,1 17,0 a8.5,8.5 0 1,1 -17,0" />
    <path
        android:fillColor="#4CC38A"
        android:pathData="M68,40 m-8.5,0 a8.5,8.5 0 1,1 17,0 a8.5,8.5 0 1,1 -17,0" />
</vector>
